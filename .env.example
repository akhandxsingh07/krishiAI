# Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL
APP_URL="MY_APP_URL"

# Firebase Web App config (Firebase Console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# x402 / Algorand Testnet
# Public Algorand address that receives the premium payment.
AVM_ADDRESS="YOUR_ALGORAND_TESTNET_RECEIVING_ADDRESS"
X402_FACILITATOR_URL="https://facilitator.goplausible.xyz"
X402_PREMIUM_PRICE_USD="$0.01"

# Local gateway / core server
GATEWAY_PORT="3002"
KRISHIAI_CORE_URL="http://127.0.0.1:3001"
